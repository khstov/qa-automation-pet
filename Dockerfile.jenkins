FROM jenkins/jenkins:2.580.1-jdk21

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

USER jenkins

RUN jenkins-plugin-cli --plugins \
    workflow-aggregator:608.v67378e9d3db_1 \
    git:5.10.1 \
    allure-jenkins-plugin:3.0.0